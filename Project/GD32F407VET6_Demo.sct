; GD32F407VET6: SRAM 192KB + CCM 64KB（CCM 不给 DMA 缓冲）
LR_IROM1 0x08000000 0x00080000  {
  ER_IROM1 0x08000000 0x00080000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00030000  {
   .ANY (+RW +ZI)
  }
  RW_IRAM2 0x10000000 0x00010000  {
   ; AC6：ZI + section(".ccmram") 实际段名是 .ccmram（不是 .bss.ccmram）
   *(.ccmram)
  }
}
